        </mxCell>
        <mxCell id="l2wsSnraBKrME0LePlul-43" value="This is a draggable container form with a title and that inside instantiates the StageEditorSPT class that extends Sprite and implements or exposes some of its properties through composition.&#xa;" style="text;align=left;verticalAlign=middle;resizable=1;points=[];autosize=0;strokeColor=#b85450;fillColor=#f8cecc;movable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;collapsible=0;container=0;overflow=visible;fixedWidth=0;whiteSpace=wrap;" parent="l2wsSnraBKrME0LePlul-42" vertex="1">
