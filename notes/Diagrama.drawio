        <mxCell id="l2wsSnraBKrME0LePlul-6" value="&lt;span style=&quot;font-weight: normal;&quot;&gt;3) app/start/Index.js&lt;/span&gt;" style="swimlane;whiteSpace=wrap;html=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="310" y="200" width="230" height="260" as="geometry" />
        </mxCell>
        <mxCell id="l2wsSnraBKrME0LePlul-7" value="Index.js is responsible for listening when the entire jAction library is loaded, then initializes predefined components of the library and its framework, the server, and other reusable ones that do not need to be reinstantiated, creates properties with reference to certain instances, so that they are accessible from the global variable G, stores some values ​​from the config.json file which is loaded by the library and finally Index.js instantiates AppStart.js this.AppStart = new AppStart();" style="text;align=left;verticalAlign=middle;resizable=1;points=[];autosize=0;strokeColor=none;fillColor=none;movable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;collapsible=0;container=0;overflow=visible;fixedWidth=0;whiteSpace=wrap;" parent="l2wsSnraBKrME0LePlul-6" vertex="1">
          <mxGeometry x="9" y="30" width="190" height="220" as="geometry" />
        </mxCell>
        <mxCell id="l2wsSnraBKrME0LePlul-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=-0.008;entryY=0.137;entryDx=0;entryDy=0;entryPerimeter=0;" parent="WIyWlLk6GJQsqaUBKTNV-1" source="zkfFHV4jXpPFQw0GAbJ--18" target="l2wsSnraBKrME0LePlul-7" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l2wsSnraBKrME0LePlul-11" value="&lt;span style=&quot;font-weight: normal;&quot;&gt;4) app/start/AppStart.js&lt;/span&gt;" style="swimlane;whiteSpace=wrap;html=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="620" y="460" width="600" height="320" as="geometry" />
        </mxCell>
        <mxCell id="l2wsSnraBKrME0LePlul-12" value="AppStart.js is the final part of the initialization, this file is in charge of listening every time the skin system has changed to reload the necessary files and styles, it also decides which graphical screen to show depending on the type of action and the programmed options, for example a previous login, a recovery screen, a registration screen, etc., this is still to be decided, at the moment the default graphical screen that is loaded as the final part of the project initialization and as a starting point for the UI is in principle the Login screen. From here on all UI screen loadings are done dynamically using LoadForm" style="text;align=left;verticalAlign=middle;resizable=1;points=[];autosize=0;strokeColor=none;fillColor=none;movable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;collapsible=0;container=0;overflow=visible;fixedWidth=0;whiteSpace=wrap;" parent="l2wsSnraBKrME0LePlul-11" vertex="1">
