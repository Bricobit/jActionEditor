        <mxCell id="l2wsSnraBKrME0LePlul-42" value="&lt;span style=&quot;font-weight: 400;&quot;&gt;\app\forms\windows\StageEditor.js StageEditor Extends Form Implements&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: rgb(232, 232, 234); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; font-weight: normal; white-space: pre;&quot;&gt;StageEditorSPT&lt;/span&gt;" style="swimlane;whiteSpace=wrap;html=1;direction=east;fillColor=#E6E6E6;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
